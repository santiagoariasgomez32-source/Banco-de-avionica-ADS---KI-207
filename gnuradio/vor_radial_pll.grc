options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: vor_radial_pll
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Decodificador VOR con PLL (radial)
    window_size: (1100,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: 1.2e6
    comment: Muestreo del RTL-SDR (1.2 MS/s)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 12
    rotation: 0
    state: enabled
- name: env_rate
  id: variable
  parameters:
    value: 100e3
    comment: Muestreo tras decimar por 12
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 330
    - 12
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    value: 113.9e6
    comment: Frecuencia del VOR (BOG 113.9 MHz; SOA 108.6 MHz)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 460
    - 12
    rotation: 0
    state: enabled
- name: rf_gain
  id: variable
  parameters:
    value: '40'
    comment: Ganancia RF
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 590
    - 12
    rotation: 0
    state: enabled
- name: if_gain
  id: variable
  parameters:
    value: '30'
    comment: Ganancia IF
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 700
    - 12
    rotation: 0
    state: enabled
- name: var_bw
  id: variable
  parameters:
    value: '3'
    comment: Ancho de banda del PLL de 30 Hz (Hz)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 810
    - 12
    rotation: 0
    state: enabled
- name: ref_bw
  id: variable
  parameters:
    value: '300'
    comment: Ancho de banda del PLL de FM de la referencia (Hz)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 920
    - 12
    rotation: 0
    state: enabled
- name: offset
  id: variable
  parameters:
    value: '270'
    comment: Calibracion del radial (grados), se resta
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1040
    - 12
    rotation: 0
    state: enabled
- name: import_math
  id: import
  parameters:
    imports: import math
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1160
    - 12
    rotation: 0
    state: enabled
