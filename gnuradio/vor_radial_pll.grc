- name: lp_decim
  id: low_pass_filter
  parameters:
    type: fir_filter_ccf
    decim: '12'
    interp: '1'
    gain: '1'
    samp_rate: samp_rate
    cutoff_freq: 15e3
    width: 3e3
    win: window.WIN_HAMMING
    beta: '6.76'
    comment: 'Pasabajos 15 kHz y decimacion por 12: 1.2 MS/s a 100 kS/s'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 260
    - 220
    rotation: 0
    state: enabled
- name: envolvente
  id: blocks_complex_to_mag
  parameters:
    vlen: '1'
    comment: 'Envolvente AM: aqui estan los 30 Hz, la subportadora de 9960 Hz y el ident'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 470
    - 232
    rotation: 0
    state: enabled
- name: bp_var
  id: band_pass_filter
  parameters:
    type: fir_filter_fff
    decim: '1'
    interp: '1'
    gain: '1'
    samp_rate: env_rate
    low_cutoff_freq: '20'
    high_cutoff_freq: '40'
    width: '15'
    win: window.WIN_HAMMING
    beta: '6.76'
    comment: 'VAR: pasabanda 20 a 40 Hz'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 660
    - 120
    rotation: 0
    state: enabled
- name: hilbert_var
  id: hilbert_fc
  parameters:
    num_taps: '129'
    win: window.WIN_HAMMING
    beta: '6.76'
    comment: 'VAR: senal compleja (analitica)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 870
    - 128
    rotation: 0
    state: enabled
- name: mixer_var
  id: blocks_multiply_xx
  parameters:
    type: complex
    num_inputs: '2'
    vlen: '1'
    comment: 'VAR: baja a cerca de 0 Hz con el LO de -30 Hz'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1070
    - 128
    rotation: 0
    state: enabled
- name: pll_var
  id: analog_pll_refout_cc
  parameters:
    w: 2*math.pi*var_bw/env_rate
    max_freq: 2*math.pi*8/env_rate
    min_freq: -2*math.pi*8/env_rate
    comment: 'VAR: PLL de 3 Hz, rango +-8 Hz. Entrega el tono enganchado, limpio'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1270
    - 128
    rotation: 0
    state: enabled
- name: lo_30
  id: analog_sig_source_x
  parameters:
    type: complex
    samp_rate: env_rate
    waveform: analog.GR_COS_WAVE
    freq: '-30'
    amp: '1'
    offset: '0'
    phase: '0'
    showports: 'False'
    comment: 'Oscilador local de -30 Hz, el MISMO para VAR y REF: no altera la diferencia de fase'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1070
    - 330
    rotation: 0
    state: enabled
- name: bp_ref
  id: band_pass_filter
  parameters:
    type: fir_filter_fff
    decim: '1'
    interp: '1'
    gain: '1'
    samp_rate: env_rate
    low_cutoff_freq: '9480'
    high_cutoff_freq: '10440'
    width: '150'
    win: window.WIN_HAMMING
    beta: '6.76'
    comment: 'REF: aisla la subportadora de 9960 Hz'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 660
    - 560
    rotation: 0
    state: enabled
- name: hilbert_ref
  id: hilbert_fc
  parameters:
    num_taps: '129'
    win: window.WIN_HAMMING
    beta: '6.76'
    comment: 'REF: senal compleja'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 870
    - 568
    rotation: 0
    state: enabled
- name: mixer_ref
  id: blocks_multiply_xx
  parameters:
    type: complex
    num_inputs: '2'
    vlen: '1'
    comment: 'REF: baja la subportadora a 0 Hz'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1070
    - 568
    rotation: 0
    state: enabled
- name: lo_9960
  id: analog_sig_source_x
  parameters:
    type: complex
    samp_rate: env_rate
    waveform: analog.GR_COS_WAVE
    freq: '-9960'
    amp: '1'
    offset: '0'
    phase: '0'
    showports: 'False'
    comment: Oscilador local de -9960 Hz
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1070
    - 700
    rotation: 0
    state: enabled
- name: pll_fm
  id: analog_pll_freqdet_cf
  parameters:
    w: 2*math.pi*ref_bw/env_rate
    max_freq: 2*math.pi*700/env_rate
    min_freq: -2*math.pi*700/env_rate
    comment: 'REF: PLL de 300 Hz que sigue la frecuencia instantanea (demodula la FM, desviacion +-480 Hz)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1270
    - 568
    rotation: 0
    state: enabled
- name: bp_ref2
  id: band_pass_filter
  parameters:
    type: fir_filter_fff
    decim: '1'
    interp: '1'
    gain: '1'
    samp_rate: env_rate
    low_cutoff_freq: '20'
    high_cutoff_freq: '40'
    width: '15'
    win: window.WIN_HAMMING
    beta: '6.76'
    comment: 'REF: limpia el tono de 30 Hz ya demodulado'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1470
    - 560
    rotation: 0
    state: enabled
- name: hilbert_ref2
  id: hilbert_fc
  parameters:
    num_taps: '129'
    win: window.WIN_HAMMING
    beta: '6.76'
    comment: 'REF: senal compleja'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1670
    - 568
    rotation: 0
    state: enabled
- name: mixer_ref2
  id: blocks_multiply_xx
  parameters:
    type: complex
    num_inputs: '2'
    vlen: '1'
    comment: 'REF: baja a cerca de 0 Hz con el mismo LO de -30 Hz'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1870
    - 568
    rotation: 0
    state: enabled
- name: pll_ref
  id: analog_pll_refout_cc
  parameters:
    w: 2*math.pi*var_bw/env_rate
    max_freq: 2*math.pi*8/env_rate
    min_freq: -2*math.pi*8/env_rate
    comment: 'REF: PLL de 3 Hz, igual al de VAR'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2070
    - 568
    rotation: 0
    state: enabled
- name: comparador
  id: blocks_multiply_conjugate_cc
  parameters:
    vlen: '1'
    comment: 'Entrada 0 = REF, entrada 1 = VAR (sentido invertido, equivale a --invert). Salida: REF x conj(VAR)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1470
    - 300
    rotation: 0
    state: enabled
- name: fase
  id: blocks_complex_to_arg
  parameters:
    vlen: '1'
    comment: Angulo = diferencia de fase (radianes)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1670
    - 308
    rotation: 0
    state: enabled
- name: a_grados
  id: blocks_multiply_const_vxx
  parameters:
    type: float
    const: 180/math.pi
    vlen: '1'
    comment: Radianes a grados
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1850
    - 308
    rotation: 0
    state: enabled
- name: calibracion
  id: blocks_add_const_vxx
  parameters:
    type: float
    const: -offset
    vlen: '1'
    comment: 'Resta el offset de calibracion: radial = fase - 270'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2030
    - 308
    rotation: 0
    state: enabled
- name: a_20_por_s
  id: blocks_keep_one_in_n
  parameters:
    type: float
    n: int(env_rate/20)
    vlen: '1'
    comment: De 100000 muestras/s a 20 valores/s
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2210
    - 308
    rotation: 0
    state: enabled
- name: salida_udp
  id: network_udp_sink
  parameters:
    type: float
    addr: '"127.0.0.1"'
    port: '6006'
    header: '0'
    payloadsize: '40'
    send_eof: 'True'
    vlen: '1'
    comment: UDP 127.0.0.1:6006 hacia el puente o hacia ver_radial.py
